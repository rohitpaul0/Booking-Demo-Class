PORT=8000
# Booking creation uses a MongoDB transaction + a per-mentor lock document, so
# the deployment must support transactions (MongoDB Atlas or a replica set).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.spmxnqc.mongodb.net/?appName=Cluster0
CORS_ORIGIN=http://localhost:5173
# Base URL used to build the dummy demo-class verification link.
APP_BASE_URL=http://localhost:8000

# SMTP configuration for email notifications (Nodemailer)
# SMTP_TRANSPORT: smtp (default) | json | stream
#   - smtp:   send through a real SMTP server using the credentials below
#   - json:   resolve the message into a JSON object (safe offline test, logs nothing to inboxes)
#   - stream: resolve the message into a stream buffer (safe offline test, logs nothing to inboxes)
SMTP_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Booking Demo Class <no-reply@example.com>

# Optional: set to false for local SMTP servers that need no authentication
# SMTP_AUTH=true
# Optional: advanced SMTP timeouts in milliseconds
# SMTP_CONNECTION_TIMEOUT=10000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=30000
# Safety rail for the notification flow in demo mode only (SMTP_TRANSPORT=json|stream):
# Comma separated list of recipient emails that should be simulated as failing.
# DEMO_FAIL_EMAILS=